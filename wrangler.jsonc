{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-mini-cloud",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "vars": {
    "LLM_API_URL": "https://api.cloudflare.com/client/v4/accounts/8ab1187a292bbc0c00ad123c38607c57/ai/v1/chat/completions",
    "LLM_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hermes-mini-db",
      "database_id": "2c5344ce-b5a9-4c82-bbc7-0eba7ad98155",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
